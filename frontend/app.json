{
  "expo": {
    "name": "DoBetter",
    "slug": "DoBetter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#B85C3E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dobetter.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "DoBetter sends reminders for birthdays, anniversaries, and upcoming events."
      }
    },
    "android": {
      "package": "com.dobetter.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B85C3E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "EXPO_PUBLIC_GRAPHQL_URL": "",
      "eas": {
        "projectId": "0e9051b1-e562-4e24-8023-8ffb78963689"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow DoBetter to access your contacts so you can select people to add."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B85C3E"
        }
      ]
    ],
    "owner": "mbrawlings"
  }
}
